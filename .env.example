# Kisan Direct AI — environment variables.
# Copy to .env for local dev:  cp .env.example .env
# NEVER commit a real .env, and NEVER put real secrets in this file.
# In production, set these as platform secrets (e.g. `fly secrets set ...`),
# not in a file and not in fly.toml or docker-compose.yml.

# Environment: development (default) or production.
# Production turns on the fail-fast checks in mvp/backend/main.py.
KISAN_ENV=development

# JWT signing secret. REQUIRED in production: at least 32 characters and
# not a placeholder. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If this is missing or a placeholder in production, the backend refuses
# to start. In dev it falls back to a dev-only default (localhost only).
KISAN_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# JWT session lifetime in minutes.
KISAN_JWT_MINUTES=720

# CORS origins, comma-separated. REQUIRED in production, and it must not
# contain "*" or localhost. In production this is the public frontend
# origin, e.g. https://kisan-direct-ai.fly.dev. With same-origin serving
# (KISAN_SERVE_FRONTEND=1) the browser does not need CORS at all, but
# the variable is still required as a safety check.
# Local dev default: http://127.0.0.1:5500,http://localhost:5500
KISAN_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Demo seed data (demo farmer ramesh@example.com / demo1234, demo buyer,
# and 3 sample listings). 1 = create on first run with an empty DB,
# 0 = never create. Default: 1 in dev, 0 in production. In production
# set this to 1 ONLY if you deliberately want the public demo accounts.
KISAN_SEED_DEMO_DATA=1

# Serve the API docs (/docs, /redoc, /openapi.json). Default: 1 in dev,
# 0 in production. Set to 1 in production only while debugging, then
# turn it back off.
KISAN_ENABLE_DOCS=1

# Serve the whole website from the backend (same origin, no separate
# frontend host): / homepage, /auth, /marketplace, /dashboard.
# Default: 1 in both dev and production.
KISAN_SERVE_FRONTEND=1

# SQLite database file. Production (fly.toml) sets /data/kisan_direct.db
# on the persistent volume. Local dev default: mvp/backend/kisan_direct.db
KISAN_DB_PATH=

# Predict-endpoint rate limit, requests per minute per IP. Default 60.
KISAN_PREDICT_RATE_LIMIT=60
